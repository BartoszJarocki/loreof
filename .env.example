# Redis. Required in production. Set one pair: KV_* or its UPSTASH_* alias.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Private Vercel Blob store. Required in production.
BLOB_READ_WRITE_TOKEN=
# Optional namespace for Blob paths. Must start with a letter or digit and end with a slash.
# LORE_BLOB_PREFIX=

# Salt for hashed visitor IPs. Required in production.
LORE_IP_SALT=
# Authenticates the hourly checkpoint cleanup cron. Required in production.
CRON_SECRET=
# Canonical origin for links and share images. Required in production for a custom domain;
# defaults to the Vercel production hostname.
NEXT_PUBLIC_SITE_URL=

# Raises GitHub REST rate limits for metadata. Optional.
# GITHUB_TOKEN=

# Namespace for Redis keys. Optional; defaults to lore:v1.
# LORE_REDIS_PREFIX=

# Gateway model ID. Optional; defaults to anthropic/claude-sonnet-5.5.
# LORE_MODEL=anthropic/claude-sonnet-5.5
# Monthly narration budget in US dollars. Optional; defaults to 20.
# LORE_AI_MONTHLY_USD=20
# AI Gateway API key for local or non-Vercel runs. Optional on Vercel.
# AI_GATEWAY_API_KEY=
# Vercel provides VERCEL_OIDC_TOKEN at runtime. Do not set or paste it here.

# Admission limits. Optional; these are the defaults.
# LORE_DAILY_LIMIT=10
# LORE_MONTHLY_LIMIT=100
# LORE_CONCURRENT_LIMIT=2
# LORE_IP_DAILY_LIMIT=3

# Browser tests. Optional and not read by the app; see docs/testing.md.
# LORE_TEST_URL=http://127.0.0.1:3000
# LORE_LIVE_BROWSER=1
# LORE_SNAPSHOT_JSON_DIR=.cache/gallery
